  "routeFixtures": {
    "createSnippet": {
      "summary": "POST /snippet — Create a new snippet (auth required)",
      "auth": "alice",
      "request": {
        "method": "POST",
        "url": "http://localhost:3003/snippet",
        "headers": {
          "Authorization": "Bearer <alice-jwt>",
          "Content-Type": "application/json"
        },
        "body": {
          "title": "New Snippet from Test",
          "description": "Created during testing",
          "language": "javascript",
          "code": "console.log('test');",
          "visibility": "public"
        }
      },
      "expectedStatus": 201,
      "expectedBodyShape": {
        "message": "Snippet created",
        "snippet": {}
      }
    },
    "getOwnSnippets": {
      "summary": "GET /snippet?page=1&limit=10 — List authenticated user's snippets (auth required)",
      "auth": "alice",
      "request": {
        "method": "GET",
        "url": "http://localhost:3003/snippet?page=1&limit=10",
        "headers": {
          "Authorization": "Bearer <alice-jwt>"
        }
      },
      "expectedStatus": 200,
      "expectedCount": 5,
      "expectedBodyShape": {
        "message": "Snippets fetched",
        "snippets": []
      }
    },
    "getPublicSnippets": {
      "summary": "GET /snippet/public/:userId?page=1&limit=10 — List public snippets for a user (no auth)",
      "request": {
        "method": "GET",
        "url": "http://localhost:3003/snippet/public/a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11?page=1&limit=10",
        "headers": {
          "Content-Type": "application/json"
        }
      },
      "expectedStatus": 200,
      "expectedCount": 3,
      "expectedBodyShape": {
        "message": "Snippets fetched",
        "snippets": []
      }
    },
    "updateSnippet": {
      "summary": "PATCH /snippet/:id — Update a snippet (auth required, id in body)",
      "auth": "alice",
      "request": {
        "method": "PATCH",
        "url": "http://localhost:3003/snippet/11111111-1111-4111-8111-111111111111",
        "headers": {
          "Authorization": "Bearer <alice-jwt>",
          "Content-Type": "application/json"
        },
        "body": {
          "id": "11111111-1111-4111-8111-111111111111",
          "title": "Hello World TypeScript (updated)",
          "description": "Updated description",
          "language": "typescript",
          "code": "console.log('Hello, Updated World!');",
          "visibility": "public"
        }
      },
      "expectedStatus": 200,
      "expectedBodyShape": {
        "message": "Snippet updated",
        "snippet": {}
      }
    },
    "deleteSnippet": {
      "summary": "DELETE /snippet/:id — Delete a snippet (auth required, id in body)",
      "auth": "alice",
      "request": {
        "method": "DELETE",
        "url": "http://localhost:3003/snippet/55555555-5555-4555-8555-555555555555",
        "headers": {
          "Authorization": "Bearer <alice-jwt>",
          "Content-Type": "application/json"
        },
        "body": {
          "id": "55555555-5555-4555-8555-555555555555"
        }
      },
      "expectedStatus": 200,
      "expectedBodyShape": {
        "message": "Snippet deleted",
        "snippet": {}
      }
    },
    "errorUnauthorized": {
