# ==============================================================================
# Root Environment Variables (.env.example)
# lc-judge Monorepo
# ==============================================================================

# Global Environment
NODE_ENV=development

# ------------------------------------------------------------------------------
# Authentication (Shared Package @artifact/auth)
# ------------------------------------------------------------------------------
# Secret key used for signing and verifying JWT tokens
JWT_SECRET=your_super_secret_jwt_key_here

# ------------------------------------------------------------------------------
# Gateway Service (apps/gateway)
# ------------------------------------------------------------------------------
GATEWAY_PORT=3000
IDENTITY_SERVICE_URL=http://localhost:3001
SNIPPET_SERVICE_URL=http://localhost:3003
EXECUTION_SERVICE_URL=http://localhost:3004

# ------------------------------------------------------------------------------
# Identity Service (apps/identity-service)
# ------------------------------------------------------------------------------
IDENTITY_PORT=3001
# PostgreSQL Connection URL (matches apps/identity-service/docker-compose.yml)
IDENTITY_DATABASE_URL=postgresql://postgres:mysecretpassword@localhost:5432/identity_db

# ------------------------------------------------------------------------------
# Snippet Service (apps/snippet-service)
# ------------------------------------------------------------------------------
SNIPPET_PORT=3003
# PostgreSQL Connection URL (matches apps/snippet-service/docker-compose.yml on host port 5433)
SNIPPET_DATABASE_URL=postgresql://postgres:mysecretpassword@localhost:5433/snippet_db

# ------------------------------------------------------------------------------
# Execution Service (apps/execution-service)
# ------------------------------------------------------------------------------
EXECUTION_PORT=3004
EXECUTION_DATABASE_URL=postgresql://postgres:mysecretpassword@localhost:5434/execution_db
EXECUTION_CALLBACK_BASE_URL=http://localhost:3004
RUNNER_CALLBACK_TOKEN=replace_with_a_long_random_secret
# RabbitMQ Connection URL (matches root docker-compose.yaml)
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# ------------------------------------------------------------------------------
# Runner Service (apps/runner-service)
# ------------------------------------------------------------------------------
RUNNER_PORT=3005
PYTHON_RUNNER_IMAGE=python:3.12-alpine
EXECUTION_TIMEOUT_MS=5000

# ==============================================================================
# Service-Specific Quick Reference (if running services directly with local .env)
# ==============================================================================
#
# apps/gateway/.env:
#   PORT=3000
#   IDENTITY_SERVICE_URL=http://localhost:3001
#   SNIPPET_SERVICE_URL=http://localhost:3003
#
# apps/identity-service/.env:
#   PORT=3001
#   DATABASE_URL=postgresql://postgres:mysecretpassword@localhost:5432/identity_db
#   JWT_SECRET=your_super_secret_jwt_key_here
#
# apps/snippet-service/.env:
#   PORT=3003
#   DATABASE_URL=postgresql://postgres:mysecretpassword@localhost:5433/snippet_db
#   JWT_SECRET=your_super_secret_jwt_key_here
#
# apps/execution-service/.env:
#   PORT=3004
#   RABBITMQ_URL=amqp://guest:guest@localhost:5672
#
